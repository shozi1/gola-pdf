# ==============================================================================
# Gola PDF - Environment Configuration
# ==============================================================================

# Primary Production Domain
DOMAIN=golapdf.com
ADMIN_EMAIL=admin@golapdf.com

# Server Binding
PORT=8080
HOST=127.0.0.1
WORKERS=2
LOG_LEVEL=warning

# Ephemeral File Retention (Hours before automatic deletion)
RETENTION_HOURS=2.0

# Maximum Upload Size (Megabytes)
MAX_UPLOAD_MB=100

# Google AdSense Publisher ID (replace with your approved publisher ID)
ADSENSE_PUBLISHER_ID=pub-0000000000000000

# Google Cloud Storage (Optional - Local Ephemeral Storage used by default)
# GCS_BUCKET_NAME=gola-pdf-storage
# GCS_PROJECT_ID=gola-pdf-cloud
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcs-key.json
